+// The start node is the safe interval of the start vertex that contains t = 0
+// (upstream takes the first interval, which may begin later).
+static bool pick_start_at_time_zero(std::vector<Node>& out_starts,
+                                    const std::vector<Node>& endpoints)
+{
+    for(const auto& ep : endpoints)
+        if(ep.interval.first <= CN_EPSILON && 0.0 <= ep.interval.second + CN_EPSILON)
+        {
+            Node s = ep;
+            s.g = 0.0;
+            out_starts = {s};
+            return true;
+        }
+    return false;
+}
+
+// The goal node is the safe interval of the goal vertex that never ends
+// (upstream takes the last interval, which may be bounded).
+static bool pick_unbounded_goal(std::vector<Node>& out_goals,
+                                const std::vector<Node>& endpoints)
+{
+    for(const auto& ep : endpoints)
+        if(ep.interval.second >= CN_INFINITY / 2.0)
+        {
+            out_goals = {ep};
+            return true;
+        }
+    return false;
+}
